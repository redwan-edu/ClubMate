<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and higher (API >= 31).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- End-to-end encryption keys are bound to this device's Android Keystore and must never be
         backed up or transferred (see e2ee/KeyVault.kt). -->
    <cloud-backup>
        <exclude domain="sharedpref" path="clubmate_e2ee.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clubmate_e2ee.xml" />
    </device-transfer>
</data-extraction-rules>
